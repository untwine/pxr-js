#ifndef PXR_JS_H
#define PXR_JS_H

#include <pxr/arch/pxr.h>
#include <pxr/tf/pxr.h>

#define JS_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define JS_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define JS_PATCH_VERSION @PROJECT_VERSION_PATCH@

#define JS_VERSION (JS_MAJOR_VERSION * 10000 \
                  + JS_MINOR_VERSION * 100   \
                  + JS_PATCH_VERSION)

#define PXR_NS pxr
#define JS_INTERNAL_NS pxrInternal_v@PROJECT_VERSION_MAJOR@_@PROJECT_VERSION_MINOR@_@PROJECT_VERSION_PATCH@__pxrReserved__
#define PXR_NS_GLOBAL ::PXR_NS

namespace JS_INTERNAL_NS { }

namespace PXR_NS {
    using namespace JS_INTERNAL_NS;
}

// Import direct dependencies into js's internal namespace.
// This keeps resolution correct if package versions ever drift.
namespace JS_INTERNAL_NS {
    using namespace ARCH_INTERNAL_NS;
    using namespace TF_INTERNAL_NS;
}

#define JS_NAMESPACE_OPEN_SCOPE   namespace JS_INTERNAL_NS {
#define JS_NAMESPACE_CLOSE_SCOPE  }
#define JS_NAMESPACE_USING_DIRECTIVE using namespace PXR_NS;

#endif // PXR_JS_H
